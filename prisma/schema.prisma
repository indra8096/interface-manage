generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  role      Role     @default(COMPANY_USER)
  itRole    ITRole?  @default(IT_INTERN)
  name      String? // Nom affiché pour assignation/UX
  companyId Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company   Company? @relation(fields: [companyId], references: [id])

  // Tâches assignées par cet utilisateur
  assignedTasks Task[] @relation("AssignedBy")
}

model Company {
  id                 Int                 @id @default(autoincrement())
  name               String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  panelCardInstances PanelCardInstance[]
  tasks              Task[]
  users              User[]
}

model Task {
  id               Int       @id @default(autoincrement())
  name             String
  status           Status    @default(warning)
  score            Int       @default(0)
  category         Category  @default(general)
  description      String?
  importance       String?
  dueDate          String?
  assignedTo       String?
  assignedByUserId Int?
  assignedBy       User?     @relation(name: "AssignedBy", fields: [assignedByUserId], references: [id])
  completedAt      DateTime?
  companyId        Int
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  company          Company   @relation(fields: [companyId], references: [id])
}

model PanelCardTemplate {
  id          Int                 @id @default(autoincrement())
  name        String
  type        PanelCardType
  category    Category?
  description String?
  priority    String              @default("Moyenne")
  isActive    Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  instances   PanelCardInstance[]
}

model PanelCardInstance {
  id                Int               @id @default(autoincrement())
  templateId        Int
  companyId         Int
  total             Int?
  completed         Int?
  equipmentCount    Int?
  status            String?
  certificationDate String?
  nextAudit         String?
  deadline          String?
  isActive          Boolean           @default(true)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  company           Company           @relation(fields: [companyId], references: [id])
  template          PanelCardTemplate @relation(fields: [templateId], references: [id])

  @@unique([templateId, companyId])
}

model ServiceTemplate {
  id                Int      @id @default(autoincrement())
  name              String
  description       String
  category          Category
  icon              String?
  defaultScore      Int      @default(0)
  defaultImportance String   @default("Moyenne")
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

enum Role {
  SUPER_ADMIN
  COMPANY_ADMIN
  COMPANY_USER
}

enum ITRole {
  IT_INTERN
  IT_SUPPORT
  IT_ENGINEER
  IT_ADMIN
  IT_MANAGER
  IT_DIRECTOR
  CIO
}

enum Status {
  completed
  warning
  error
}

enum Category {
  defensive
  general
  offensive
}

enum PanelCardType {
  coverage
  infrastructure
  compliance
  recommendation
}
