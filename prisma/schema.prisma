// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  role      Role     @default(COMPANY_USER)
  companyId Int?
  company   Company? @relation(fields: [companyId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Company {
  id        Int      @id @default(autoincrement())
  name      String
  users     User[]
  tasks     Task[]
  panelCardInstances PanelCardInstance[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Task {
  id          Int      @id @default(autoincrement())
  name        String
  status      Status   @default(warning)
  score       Int      @default(0)
  category    Category @default(general)
  description String?
  importance  String?
  dueDate     String?
  assignedTo  String?
  companyId   Int
  company     Company  @relation(fields: [companyId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Templates de cartes gérés par le super admin
model PanelCardTemplate {
  id              Int      @id @default(autoincrement())
  name            String
  type            PanelCardType
  category        Category
  description     String?
  priority        String   @default("Moyenne")
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  // Instances de cette carte dans chaque entreprise
  instances       PanelCardInstance[]
}

// Instances de cartes dans chaque entreprise
model PanelCardInstance {
  id              Int      @id @default(autoincrement())
  templateId      Int
  template        PanelCardTemplate @relation(fields: [templateId], references: [id])
  companyId       Int
  company         Company  @relation(fields: [companyId], references: [id])
  
  // Données spécifiques à l'entreprise
  total           Int?
  completed       Int?
  equipmentCount  Int?
  status          String?
  certificationDate String?
  nextAudit       String?
  deadline        String?
  isActive        Boolean  @default(true)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@unique([templateId, companyId])
}

// Templates de services prédéfinis
model ServiceTemplate {
  id              Int      @id @default(autoincrement())
  name            String
  description     String
  category        Category
  icon            String?
  defaultScore    Int      @default(0)
  defaultImportance String @default("Moyenne")
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

enum Role {
  SUPER_ADMIN
  COMPANY_ADMIN
  COMPANY_USER
}

enum Status {
  completed
  warning
  error
}

enum Category {
  defensive
  general
  offensive
}

enum PanelCardType {
  coverage
  infrastructure
  compliance
  recommendation
} 