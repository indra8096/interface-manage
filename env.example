# Configuration de sécurité - Variables d'environnement
# COPIEZ ce fichier vers .env.local et configurez vos vraies valeurs

# === SÉCURITÉ CRITIQUE ===
# Clé secrète JWT - DOIT être d'au moins 32 caractères et unique
# Générez une clé sécurisée avec: openssl rand -hex 32
JWT_SECRET=votre_clé_secrète_très_longue_et_complexe_ici_minimum_32_caractères

# === BASE DE DONNÉES ===
DATABASE_URL="postgresql://username:password@localhost:5432/database_name"

# === ENVIRONNEMENT ===
NODE_ENV=production
NEXT_PUBLIC_BASE_URL=https://votre-domaine.com

# === SÉCURITÉ SUPPLÉMENTAIRE ===
# Clé de chiffrement pour les cookies (optionnel)
COOKIE_SECRET=votre_clé_de_chiffrement_cookies_ici

# Clé API pour les services externes (si nécessaire)
API_KEY=votre_clé_api_ici

# === VÉRIFICATION GOOGLE ===
# Code de vérification Google Search Console (optionnel)
GOOGLE_SITE_VERIFICATION=votre_code_verification_ici

# === LOGGING ET MONITORING ===
# URL du service de logging (optionnel)
LOG_SERVICE_URL=https://votre-service-logging.com

# Clé API pour le service de monitoring (optionnel)
MONITORING_API_KEY=votre_clé_monitoring_ici

# === RATE LIMITING ===
# Limite de tentatives de connexion par IP (optionnel)
MAX_LOGIN_ATTEMPTS=5
LOGIN_ATTEMPT_WINDOW=900000

# === SESSION ===
# Durée de vie des sessions en secondes (optionnel)
SESSION_DURATION=604800

# === CORS ===
# Origines autorisées pour CORS (optionnel)
ALLOWED_ORIGINS=https://votre-domaine.com,https://www.votre-domaine.com

# === INSTRUCTIONS DE SÉCURITÉ ===
# 1. Ne JAMAIS commiter le fichier .env.local dans Git
# 2. Utilisez des clés secrètes uniques et complexes
# 3. Changez régulièrement vos clés secrètes
# 4. Utilisez HTTPS en production
# 5. Surveillez vos logs de sécurité
# 6. Mettez à jour régulièrement vos dépendances
# 7. Testez votre application avec des outils de sécurité
